# Django Configuration
DJANGO_SECRET_KEY=generate_a_secure_random_key_for_production
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Database Configuration (PostgreSQL 16+)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/stock_intelligence

# Redis & Celery Configuration
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0

# Field Encryption Key (Fernet 32-byte base64 key for credentials at rest)
FIELD_ENCRYPTION_KEY=YD6S9lYBUKY0Lvb-7nPCU5alx8INSUhwX3NjuSlaYX0=

# Market Data Providers (Phase 2+)
ENABLE_JUGAAD_DATA=True
ENABLE_YAHOO_FINANCE=True
MARKET_DATA_PROVIDER_PRIORITY=jugaad,yahoo

# Cache TTLs
MARKET_DATA_CACHE_TTL=30
HISTORICAL_DATA_CACHE_TTL=86400

# Company Logo CDN Settings (Shareperks ISIN CDN)
SHAREPERKS_LOGO_BASE_URL=https://company-logo.shareperks.in/logo


